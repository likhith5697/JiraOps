# ---------------------------------------------------------------------------
# OpsBridge configuration. Copy to .env and fill in. NEVER commit .env.
# With MOCK_MODE=true nothing below the "Microsoft" line is required.
# ---------------------------------------------------------------------------
APP_ENV=development
# Public HTTPS base URL Graph will call (e.g. your ngrok URL), no trailing slash
APP_BASE_URL=
LOG_LEVEL=INFO
LOG_FORMAT=json
# Admin API key for /support-requests, /subscriptions, /dev (header: X-API-Key)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=dev-admin-key

# --- Microsoft Entra ID / Graph ------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Random secret Graph echoes in every notification; generate like ADMIN_API_KEY
MICROSOFT_CLIENT_STATE=
# Delegated refresh token for the service account that posts replies
# (obtain with: python scripts/get_delegated_token.py)
MICROSOFT_DELEGATED_REFRESH_TOKEN=
# Entra object id of that service account (its top-level posts are ignored)
MICROSOFT_SERVICE_ACCOUNT_USER_ID=
GRAPH_SUBSCRIPTION_LIFETIME_MINUTES=4200
GRAPH_SUBSCRIPTION_RENEWAL_THRESHOLD_MINUTES=720

TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
# Thread commands: Entra object IDs (comma-separated) of support admins who may run
# close / reopen / escalate on ANY request. The requester can always run them on their own
# request; `status` is open to everyone. (TEAMS_CLOSE_ALLOWED_USER_IDS is the older name and
# still works; both lists are merged.)
TEAMS_COMMAND_ADMIN_USER_IDS=
# Optional: channel in the same team where `escalate` posts an alert. Must NOT be the
# support channel. Leave empty to skip the alert (priority/label/comment still happen).
TEAMS_ESCALATION_CHANNEL_ID=

# --- Jira Cloud -----------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Task
# Map OpsBridge priorities to Jira priority NAMES (JSON). Use {} to not set priority.
JIRA_PRIORITY_MAP={"P1": "Highest", "P2": "High", "P3": "Medium"}
JIRA_EXTRA_LABELS=opsbridge
JIRA_RECONCILE_DELAY_SECONDS=60
# Statuses the "close" / "reopen" commands move the issue to. Matched case-insensitively against
# each available transition's target status name; transition IDs are never hard-coded.
JIRA_CLOSE_STATUS=Done
JIRA_REOPEN_STATUS=To Do
# Label added by "escalate" (alongside raising the priority via JIRA_PRIORITY_MAP).
JIRA_ESCALATION_LABEL=escalated

# --- Jira -> Teams status sync ----------------------------------------------------------
# Post status/assignee changes made in Jira into the request's Teams thread.
JIRA_SYNC_ENABLED=true
# Poll Jira for recently updated issues every N seconds (0 = no polling, webhook only).
JIRA_SYNC_POLL_INTERVAL_SECONDS=120
# Optional, for near-real-time updates: shared secret for POST /webhooks/jira
# (Jira webhook "Secret" -> X-Hub-Signature header, or ?secret=<value> in the URL).
# Leave empty to disable the endpoint. Generate like ADMIN_API_KEY.
JIRA_WEBHOOK_SECRET=

# --- Database -----------------------------------------------------------------------
DATABASE_URL=sqlite:///./opsbridge.db

# --- Processing -----------------------------------------------------------------------
MOCK_MODE=true
WORKER_COUNT=2
WORKER_POLL_INTERVAL_SECONDS=10
MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=900
HTTP_TIMEOUT_SECONDS=10
